{
  "name": "kids-playground",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "native:content": "node scripts/native/author-stories.mjs && node scripts/native/author-poem-pinyin.mjs && node scripts/native/author-military.mjs && node scripts/native/export-content.mjs",
    "native:military": "node scripts/native/author-military.mjs",
    "native:poetry:pinyin": "node scripts/native/author-poem-pinyin.mjs",
    "native:levels": "node scripts/native/author-levels.mjs",
    "native:icons": "node scripts/native/import-icons.mjs",
    "native:icons:brand": "bash scripts/native/render-brand-icons.sh",
    "native:audit": "bash scripts/native/audit-ui.sh",
    "native:build": "bash scripts/native/build-android.sh",
    "native:build:docker": "bash scripts/native/build-android-docker.sh",
    "native:build:setup": "bash scripts/native/setup-android-build-tools.sh",
    "native:deploy": "bash scripts/native/deploy-android.sh",
    "native:release:docker": "bash scripts/native/build-android-docker.sh && SKIP_BUILD=1 bash scripts/native/deploy-android.sh",
    "native:stories": "node scripts/native/author-stories.mjs"
  },
  "devDependencies": {
    "pinyin-pro": "3.29.5"
  }
}
