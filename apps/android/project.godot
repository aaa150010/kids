[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="PlantHurtBoxDetection"
2d_physics/layer_3="ZombieHurtBoxDetection"
2d_physics/layer_4="BulletFromPlant"
2d_physics/layer_5="ZombieHurtBoxDetectionOnAttack"
2d_physics/layer_6="ZombieHurtBoxDetectionBeHypnotized"
2d_physics/layer_7="Bowling"
2d_physics/layer_8="BulletFromZombie"
2d_physics/layer_9="PlantHurtBoxReal"
2d_physics/layer_10="ZombieHurtBoxReal"
2d_physics/layer_11="ZombieHurtBoxRealBeHypnotized"
2d_physics/layer_12="ItemDetect"
2d_physics/layer_13="ItemReal"
2d_physics/layer_14="LawnMover"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.938, 0.976, 0.919, 1)
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}

[gui]

theme/default_font_multichannel_signed_distance_field=true

[android]

permissions/custom_permissions=PackedStringArray("android.permission.REQUEST_INSTALL_PACKAGES")
