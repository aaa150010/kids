; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="童心游乐场"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="kids-playground"
config/version="1.4.0"
config/icon="res://assets/branding/app-icon-512.png"
boot_splash/bg_color=Color(0.035, 0.082, 0.066, 1)
boot_splash/image="res://assets/branding/app-icon-512.png"
boot_splash/fullsize=false

[autoload]

UpdateService="*res://src/core/update_service.gd"
SaveStore="*res://src/core/save_store.gd"
ContentDB="*res://src/core/content_db.gd"
AudioFX="*res://src/core/audio_fx.gd"
Speech="*res://src/core/speech.gd"
StoryAudio="*res://src/core/story_audio_service.gd"
RuntimeQuality="*res://src/core/runtime_quality.gd"
Global="*res://pvz/scenes/autoload/global.tscn"
SoundManager="*res://pvz/scenes/autoload/sound_manager.tscn"
SceneRegistry="*res://pvz/scripts/autoload/scene_registry.gd"
AllCards="*res://pvz/scenes/autoload/all_cards.tscn"
GlobalUtils="*res://pvz/scripts/autoload/util/global_utils.gd"
EventBus="*res://pvz/scripts/autoload/event_bus.gd"
TreePauseManager="*res://pvz/scripts/autoload/tree_pause_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1129
window/size/window_width_override=1600
window/size/window_height_override=1129
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[input]

